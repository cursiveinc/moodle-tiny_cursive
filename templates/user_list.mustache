{{!
    @template tiny_cursive/user_list

    Option list for the users filter of the tiny_cursive report. The script copies the options into the
    page's own labelled select, so this select is only a valid container for rendering.

    Example context (json):
    {
        "tabledata": {
            "userlist": [
                {
                    "id": "1",
                    "name": "User Name"
                }
            ]
        }
    }
}}

<select>
    <option value="">{{#str}}selectuser, tiny_cursive{{/str}}</option>
    {{#tabledata.userlist}}
        <option class="user_class" value="{{id}}">{{name}}</option>
    {{/tabledata.userlist}}
</select>
