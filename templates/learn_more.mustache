{{!
    @template tiny_cursive/learn_more

    Learn More pane shown inside the analytics modal: the three Cursive tiers. All copy comes
    from lang strings; the pane sits under the modal's h2 title, so its own heading is an h3.

    Example context (json):
    {
    }
}}

<div class="tiny_cursive-modal-container">
    <div class="tiny_cursive-modal-header-custom">
        <h3 class="tiny_cursive-learnmore-heading">{{#str}}learnmore_heading, tiny_cursive{{/str}}</h3>
        <p>{{#str}}learnmore_subtitle, tiny_cursive{{/str}}</p>
    </div>

    <div class="p-4 p-md-5">

        <div class="row g-4">
            <div class="col-12 mb-3">
                <div class="card tiny_cursive-pricing-card premium border-2 h-100">
                    <span class="tiny_cursive-pricing-badge">{{#str}}learnmore_badge, tiny_cursive{{/str}}</span>
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap">
                            <h4 class="card-title h5 fw-bold mb-0">{{#str}}learnmore_premium_title, tiny_cursive{{/str}}</h4>
                            <span class="tiny_cursive-card-price">{{#str}}learnmore_premium_price, tiny_cursive{{/str}}</span>
                        </div>
                        <p class="card-text text-muted">{{#str}}learnmore_premium_desc, tiny_cursive{{/str}}</p>
                        <div>
                            <a href="https://cursivetechnology.com/premium-supported-community-and-limited/"
                                target="_blank" rel="noopener" class="text-decoration-none">{{#str}}learnmore_premium_link, tiny_cursive{{/str}}
                                <span class="sr-only visually-hidden">({{#str}}opensinnewwindow, core{{/str}})</span></a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 mb-3">
                <div class="card tiny_cursive-pricing-card border-2 h-100">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap">
                            <h4 class="card-title h5 fw-bold mb-0">{{#str}}learnmore_community_title, tiny_cursive{{/str}}</h4>
                            <span class="tiny_cursive-card-price">{{#str}}learnmore_community_price, tiny_cursive{{/str}}</span>
                        </div>
                        <p class="card-text text-muted">{{#str}}learnmore_community_desc, tiny_cursive{{/str}}</p>
                        <div>
                            <a href="https://cursivetechnology.com/premium-supported-community-and-limited/"
                                target="_blank" rel="noopener" class="btn btn-outline-primary btn-sm">{{#str}}learnmore_community_link, tiny_cursive{{/str}}
                                <span class="sr-only visually-hidden">({{#str}}opensinnewwindow, core{{/str}})</span></a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12">
                <div class="card tiny_cursive-pricing-card border-2 h-100">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap">
                            <h4 class="card-title h5 fw-bold mb-0">{{#str}}learnmore_limited_title, tiny_cursive{{/str}}</h4>
                            <span class="tiny_cursive-card-price">{{#str}}learnmore_limited_price, tiny_cursive{{/str}}</span>
                        </div>
                        <p class="card-text text-muted">{{#str}}learnmore_limited_desc, tiny_cursive{{/str}}</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
